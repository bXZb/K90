CONFIG_KSU=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KPROBES=y
# CONFIG_KSU_DEBUG is not set
# Vendor cfg80211/btpower need rfkill in vmlinux (stock rfkill.ko does not load on custom Image).
CONFIG_RFKILL=y

# === Droidspaces（对照 Droidspaces v7.0.0 检查单；GKI defconfig 里这些键全是 n） ===
# MUST：PID namespace / IPC namespace，容器两个硬门槛
# 二分第五轮（2026-10-21）：#59（PID_NS+SYSVIPC+IPC_NS）不启动。嵌入式 config 实证
# 两内核仅差这三键（+SYSVIPC 连带的 COMPAT/SYSCTL），凶手在其中。本轮摘 PID_NS：
# CONFIG_PID_NS=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
# 二分第四轮（2026-10-21）：#58（5 核心键）仍不启动，凶手在这 5 键内。
# 本轮只留上面 3 个 namespace 硬需求，以下 2 键暂摘：
# CONFIG_DEVTMPFS=y
# CONFIG_POSIX_MQUEUE=y
# 二分第三轮（折半）：#56（摘 USER_NS）、#57（再摘 CFS_BANDWIDTH）均不启动，
# 嫌疑剩 9 键。本轮只留 5 核心键，以下 4 键暂摘：
# CONFIG_CGROUP_PIDS=y
# CONFIG_MACVLAN=y
# CONFIG_IP6_NF_NAT=y
# CONFIG_IP6_NF_TARGET_MASQUERADE=y
# 沙箱（非特权 Docker/Podman/Flatpak）。GKI 默认关。
# 真机排查（2026-10-21）：含此键的 #53/#55 fastboot boot 不启动（#54 无此键可启动），
# 摘掉观察；cred/nsproxy 热路径与厂商安全钩子交互是头号嫌疑。
# CONFIG_USER_NS=y
